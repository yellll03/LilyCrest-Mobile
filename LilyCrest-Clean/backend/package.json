{
  "name": "lilycrest-backend",
  "version": "1.0.0",
  "description": "Lilycrest Dormitory Management System API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/*.test.js",
    "billing:reconcile": "node scripts/reconcileBillingDuplicates.js",
    "billing:migrate-to-bills": "node scripts/migrateBillingToBills.js",
    "maintenance:migrate-to-primary": "node scripts/migrateMaintenanceToPrimary.js",
    "surveys:seed-sample:dry-run": "node scripts/seedSampleSurvey.js",
    "surveys:seed-sample": "node scripts/seedSampleSurvey.js --confirm",
    "users:migrate-normalized-identities": "node scripts/migrateNormalizedUserIdentities.js",
    "users:backfill-usernames:dry-run": "node scripts/backfillUsernameNormalized.js --dry-run",
    "users:backfill-usernames": "node scripts/backfillUsernameNormalized.js --confirm",
    "users:correct-legacy-username": "node scripts/correctLegacyUsername.js",
    "branches:seed:dry-run": "node scripts/seedCanonicalBranches.js --dry-run",
    "branches:seed": "node scripts/seedCanonicalBranches.js --confirm",
    "branches:indexes:dry-run": "node scripts/createBranchIndexes.js --dry-run",
    "branches:indexes": "node scripts/createBranchIndexes.js --confirm",
    "branches:approval-pack": "node scripts/prepareBranchApprovalPack.js --export",
    "branches:approve": "node scripts/approveCanonicalBranch.js --confirm",
    "identity-crosswalk:dry-run": "node scripts/identityCrosswalk.js --dry-run",
    "identity-crosswalk:export": "node scripts/identityCrosswalk.js --export",
    "identity-crosswalk:review": "node scripts/prepareIdentityReview.js --export",
    "identity-crosswalk:approve": "node scripts/approveIdentityCrosswalk.js --confirm",
    "administrative-evidence:export": "node scripts/prepareAdministrativeEvidencePack.js --export"
  },
  "dependencies": {
    "@fontsource/noto-serif": "^5.3.0",
    "@google/generative-ai": "^0.24.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "axios": "^1.13.6",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^12.0.0",
    "mongodb": "^6.3.0",
    "nodemailer": "^8.0.4",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}
