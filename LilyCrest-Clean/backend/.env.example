# Server Configuration
PORT=8001
NODE_ENV=development
# Set to true/1 only behind a trusted reverse proxy.
TRUST_PROXY=
TRUST_PROXY_HOPS=

# MongoDB Configuration
MONGO_URL=mongodb+srv://user:password@cluster.example/lilycrest-db
DB_NAME=lilycrest-db

# Firebase Configuration (Admin SDK via env)
FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your_service_account@your_project_id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/your_service_account
FIREBASE_UNIVERSE_DOMAIN=googleapis.com

# Google AI Configuration
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# Google Maps Configuration
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth Client IDs
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id_here

# PayMongo Configuration
PAYMONGO_SECRET_KEY=sk_test_xxxx
PAYMONGO_WEBHOOK_SECRET=whsec_xxxx
BACKEND_URL=https://api.lilycrest.space

# Capstone-Website's authoritative Contract API host. Must NOT be set to the
# same value as BACKEND_URL above (BACKEND_URL is this server's own public
# URL, used for callback links) — the Contract bridge in
# backend/routes/contracts.routes.js proxies to this host and will fail
# closed with a 502 if it is unset.
CONTRACT_UPSTREAM_URL=https://your-capstone-website-host.example

# Optional: canonical web frontend's password-reset action page (owned by
# Capstone-Website, e.g. https://www.lilycrest.space/auth-action). When set,
# password-reset emails link here instead of this backend's own hosted reset
# page. That page must call POST {BACKEND_URL}/api/auth/reset-password with
# {token, newPassword} to complete the reset, and MAY call
# POST {BACKEND_URL}/api/auth/reset-password/status with body {token} first to
# check the link is still valid before rendering the form (read-only, does
# not consume the token). The token is sent in the POST body, not a query
# string, so it never lands in a URL. Leave unset to keep using this
# backend's own hosted reset page (frontend://reset-password deep link +
# inline web form fallback). Do not set this until /auth-action is actually
# deployed — see docs/PASSWORD_RESET_AUTH_ACTION_HANDOFF.md for the full
# integration contract.
PASSWORD_RESET_WEB_URL=

# ImageKit uploads
IMAGEKIT_PRIVATE_KEY=private_xxxx

# CORS Configuration
CORS_ORIGINS=https://www.lilycrest.space
FRONTEND_URL=https://www.lilycrest.space
WEB_BASE_URL=https://www.lilycrest.space
MOBILE_APP_URL=frontend://
ALLOW_LOCAL_CORS=false
ALLOW_MOBILE_DEV_CORS=true

# Transactional email over HTTPS (recommended; works on Render free services)
# Create a Resend API key and verify the domain used by EMAIL_FROM.
RESEND_API_KEY=re_xxxx
EMAIL_FROM=LilyCrest Dormitory <no-reply@your-verified-domain.example>

# Optional SMTP fallback (not supported by Render free services)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=LilyCrest Dormitory <your_email@gmail.com>

# Feature flags (secure defaults)
ALLOW_PUBLIC_REGISTRATION=false
ENABLE_DEMO_DATA=false
PROFILE_IMAGE_CDN_HOSTS=
