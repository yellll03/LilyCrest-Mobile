{
  "cli": {
    "version": ">= 7.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDevelopmentDebug"
      },
      "env": {
        "NODE_ENV": "development",
        "EXPO_PUBLIC_DEPLOYMENT_ENV": "development",
        "LILYCREST_ANDROID_FLAVOR": "development"
      }
    },
    "staging": {
      "developmentClient": false,
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleStagingRelease"
      },
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_DEPLOYMENT_ENV": "staging",
        "LILYCREST_ANDROID_FLAVOR": "staging"
      }
    },
    "preview": {
      "extends": "staging"
    },
    "release": {
      "extends": "production",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleProductionRelease"
      }
    },
    "production": {
      "developmentClient": false,
      "environment": "production",
      "android": {
        "gradleCommand": ":app:bundleProductionRelease"
      },
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_DEPLOYMENT_ENV": "production",
        "EXPO_PUBLIC_BACKEND_URL": "https://api.lilycrest.space",
        "LILYCREST_ANDROID_FLAVOR": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
