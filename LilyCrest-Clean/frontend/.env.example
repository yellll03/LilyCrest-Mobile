# Backend routing
# Mobile API routing. Web/admin uses its separate admin API domain.
EXPO_PUBLIC_BACKEND_URL=https://mobile-api.lilycrest.space
# Optional documentation only. Leave blank; no active mobile fallback is configured.
EXPO_PUBLIC_BACKEND_FALLBACK_URL=

# Optional diagnostics
EXPO_PUBLIC_ASSISTANT_LOGS=false

# Firebase (shared)
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=dormitorymanagement-caps-572cf.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890

# Firebase app keys
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_WEB_API_KEY=
EXPO_PUBLIC_FIREBASE_ANDROID_API_KEY=
EXPO_PUBLIC_FIREBASE_WEB_APP_ID=
EXPO_PUBLIC_FIREBASE_ANDROID_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google OAuth client IDs
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Google Maps
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Android Google Sign-In config in app.config.js
EXPO_PUBLIC_GOOGLE_ANDROID_API_KEY=
EXPO_PUBLIC_GOOGLE_ANDROID_CERT_HASH=
