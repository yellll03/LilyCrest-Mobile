# Backend routing
# Mobile API routing. Mobile and web/admin now converge on the canonical API host.
# This is the ONLY host the app will use at runtime — src/config/api.js
# enforces an allowlist of exactly this host in production (see
# isDisallowedMobileRuntimeUrl), and there is no code path that fails over to
# a different hostname on request failure (same-host retry only). There used
# to be an EXPO_PUBLIC_BACKEND_FALLBACK_URL variable documented here; it was
# never read by any runtime code and has been removed to avoid implying a
# failover host exists.
EXPO_PUBLIC_BACKEND_URL=https://api.lilycrest.space

# Optional diagnostics
EXPO_PUBLIC_ASSISTANT_LOGS=false

# Firebase (shared)
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=dormitorymanagement-caps-572cf.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890

# Firebase app keys
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_WEB_API_KEY=
EXPO_PUBLIC_FIREBASE_ANDROID_API_KEY=
EXPO_PUBLIC_FIREBASE_WEB_APP_ID=
EXPO_PUBLIC_FIREBASE_ANDROID_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google OAuth client IDs
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Google Maps
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Android Google Sign-In config in app.config.js
EXPO_PUBLIC_GOOGLE_ANDROID_API_KEY=
EXPO_PUBLIC_GOOGLE_ANDROID_CERT_HASH=

# GOOGLE_SERVICES_JSON is NOT set here — it is a "file" type EAS environment
# variable (Project Settings > Environment Variables > production), not a
# plaintext value. Locally, place the real file at ./google-services.json
# and android/app/google-services.json (both gitignored). On EAS Build, the
# eas-build-pre-install hook (scripts/eas-copy-google-services.js) copies the
# EAS-provided file into android/app/google-services.json before Gradle runs.
