EXPO_PUBLIC_DEPLOYMENT_ENV=staging
EXPO_PUBLIC_BACKEND_URL=https://staging-api.example.test

# Dedicated non-production Firebase client configuration.
EXPO_PUBLIC_FIREBASE_API_KEY=replace-me
EXPO_PUBLIC_FIREBASE_WEB_API_KEY=replace-me
EXPO_PUBLIC_FIREBASE_ANDROID_API_KEY=replace-me
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=lilycrest-staging-qa.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=lilycrest-staging-qa
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=lilycrest-staging-qa.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-me
EXPO_PUBLIC_FIREBASE_WEB_APP_ID=replace-me
EXPO_PUBLIC_FIREBASE_ANDROID_APP_ID=replace-me

# Dedicated OAuth clients registered for com.lilycrest.lilycrestdorm.staging.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace-me.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=replace-me.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_API_KEY=replace-me
EXPO_PUBLIC_GOOGLE_ANDROID_CERT_HASH=replace-me

LILYCREST_ANDROID_FLAVOR=staging
# GOOGLE_SERVICES_JSON is a secret-manager file variable, not a committed path.
